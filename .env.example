# Öffentliche Basis-URL des Servers (ohne trailing slash).
# Lokal: http://localhost:3000 — auf EasyPanel: https://<app>.<domain>
# WICHTIG: Muss exakt der öffentlich erreichbaren URL entsprechen (Issuer-Match!).
BASE_URL=http://localhost:3000

# Port, auf dem der Server lauscht.
PORT=3000

# Mindestens 32 Zeichen, z. B. via: openssl rand -base64 48
TOKEN_SECRET=change-me-token-secret-min-32-chars-please
SESSION_SECRET=change-me-session-secret-min-32-chars-please

# Test-Nutzer für das Login-Formular (JSON-Array, Klartext-Passwörter — NUR für Testserver!)
# Nur Pflicht, wenn AUTH_PROVIDERS 'local' enthält.
USERS_JSON=[{"email":"test@example.com","password":"test1234","name":"Test User"}]

# Access-Token-TTL in Sekunden. 60 = ideal zum Testen des Refresh-Flows.
ACCESS_TOKEN_TTL=60

# Refresh-Token-TTL in Sekunden (Default: 30 Tage).
REFRESH_TOKEN_TTL=2592000

# Optional: Pfad zur State-Datei für Persistenz von DCR-Clients + Refresh-Tokens.
# Ohne diese Variable läuft der Server rein in-memory (State weg bei Restart).
# Auf EasyPanel: Volume auf /data mounten und STATE_FILE=/data/state.json setzen.
# STATE_FILE=/data/state.json

# ─── SSO (externe Identity Provider) ────────────────────────────────────────
# Komma-separierte Liste aktiver Login-Methoden: local, google, entra
# Default: local (nur Formular). Beispiele:
#   AUTH_PROVIDERS=local,google     → Formular + Google-Button
#   AUTH_PROVIDERS=google,entra     → nur SSO-Buttons, kein Formular (USERS_JSON dann unnötig)
# AUTH_PROVIDERS=local

# Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web)
# Redirect URI dort eintragen: https://<host>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Entra Portal → App registrations (Single tenant) → Client ID + Secret
# Redirect URI dort eintragen: https://<host>/auth/entra/callback
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# Allowlist für SSO-Logins (komma-separiert). Wenn BEIDE leer sind, kann sich
# JEDER Account des IdP einloggen (Boot-Warnung). Bei Entra-Single-Tenant ist
# die Org bereits durch den Tenant begrenzt — die Allowlist ist dann optional.
# SSO_ALLOWED_DOMAINS=jungherz.de
# SSO_ALLOWED_EMAILS=mk@example.com,chef@example.com
